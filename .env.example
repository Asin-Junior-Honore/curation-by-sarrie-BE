# MongoDB
MONGODB_URL=
MONGODB_DB_NAME=curationbysarrie

# Bumpa API
BUMPA_BASE_URL=https://api.getbumpa.com/api/commerce/v1
BUMPA_API_KEY=
BUMPA_STORE_ID=

# Server
CORS_ORIGINS=http://localhost:3000,https://curationbysarrie.netlify.app

# Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super admin (created on first run)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Sarrie Admin

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@curationbysarrie.com
SMTP_FROM_NAME=Curation by Sarrie
ADMIN_PANEL_URL=http://localhost:3000/admin/login